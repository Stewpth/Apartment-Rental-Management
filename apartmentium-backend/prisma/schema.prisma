generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  TENANT
}

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  DISABLED
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
}

enum RentalStatus {
  ACTIVE
  ON_LEAVING
  ENDED
}

enum MonthlyDueStatus {
  UNPAID
  PARTIAL
  PAID
}

enum CreditTransactionType {
  CREDIT_CREATED
  CREDIT_APPLIED
  REFUND
}

// ==========================================
// USER
// ==========================================

model User {
  id           String        @id @default(uuid())
  fullName     String
  username     String        @unique
  email        String        @unique
  passwordHash String
  phone        String?
  profileImage String?
  role         UserRole
  status       AccountStatus @default(PENDING_ACTIVATION)

  // Rental relationships
  tenantRentals Rental[] @relation("TenantRentals")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
}

// ==========================================
// UNIT
// ==========================================

model Unit {
  id          String     @id @default(uuid())
  unitNumber  String     @unique
  description String?
  monthlyRent Decimal    @db.Decimal(10, 2)
  status      UnitStatus @default(AVAILABLE)

  rentals Rental[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// ==========================================
// RENTAL
// ==========================================

model Rental {
  id String @id @default(uuid())

  tenantId String
  tenant   User   @relation("TenantRentals", fields: [tenantId], references: [id], onDelete: Restrict)

  unitId String
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  // Snapshot of the agreed rent when the rental is created
  monthlyRent Decimal @db.Decimal(10, 2)

  moveInDate DateTime @db.Date

  // Leaving request and actual move-out are separate events
  leavingRequestedAt DateTime?
  actualMoveOutDate  DateTime? @db.Date

  status RentalStatus @default(ACTIVE)

  // Monthly billing records
  monthlyDues MonthlyDue[]
  payments    Payment[]

  tenantCredit TenantCredit?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([unitId])
  @@index([status])
}

// ==========================================
// MONTHLY DUE
// ==========================================

model MonthlyDue {
  id String @id @default(uuid())

  rentalId String
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Restrict)

  // Billing period and payment deadline
  billingPeriod DateTime @db.Date
  dueDate       DateTime @db.Date

  // Payment tracking
  amountDue  Decimal          @db.Decimal(10, 2)
  amountPaid Decimal          @default(0) @db.Decimal(10, 2)
  balance    Decimal          @db.Decimal(10, 2)
  status     MonthlyDueStatus @default(UNPAID)

  allocations        PaymentAllocation[]
  creditTransactions CreditTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rentalId, billingPeriod])
  @@index([rentalId])
  @@index([dueDate])
  @@index([status])
}

// PAYMENT
model Payment {
  id String @id @default(uuid())

  rentalId String
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Restrict)

  // Total amount received from the tenant
  amount Decimal @db.Decimal(10, 2)

  // Date when the landlord received the payment
  paymentDate DateTime @db.Date

  // Payment allocation records
  allocations        PaymentAllocation[]
  creditTransactions CreditTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rentalId])
  @@index([paymentDate])
}

// PAYMENT ALLOCATION
model PaymentAllocation {
  id String @id @default(uuid())

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  monthlyDueId String
  monthlyDue   MonthlyDue @relation(fields: [monthlyDueId], references: [id], onDelete: Restrict)

  // Amount allocated to a specific monthly due
  amount Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  // Prevent duplicate allocation for the same payment and bill
  @@unique([paymentId, monthlyDueId])
  @@index([monthlyDueId])
}

// TENANT CREDIT
model TenantCredit {
  id String @id @default(uuid())

  rentalId String @unique
  rental   Rental @relation(fields: [rentalId], references: [id], onDelete: Restrict)

  // Current available credit balance
  balance Decimal @default(0) @db.Decimal(10, 2)

  // Credit history
  transactions CreditTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// CREDIT TRANSACTION
model CreditTransaction {
  id String @id @default(uuid())

  tenantCreditId String
  tenantCredit   TenantCredit @relation(fields: [tenantCreditId], references: [id], onDelete: Restrict)

  type   CreditTransactionType
  amount Decimal               @db.Decimal(10, 2)

  // Optional references depending on transaction type
  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  monthlyDueId String?
  monthlyDue   MonthlyDue? @relation(fields: [monthlyDueId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  notes     String?

  @@index([tenantCreditId])
  @@index([type])
  @@index([paymentId])
  @@index([monthlyDueId])
}
