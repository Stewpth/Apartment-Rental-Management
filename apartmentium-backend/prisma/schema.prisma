generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TENANT
}

enum AccountStatus {
  PENDING_ACTIVATION
  ACTIVE
  DISABLED
}

enum UnitStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
}

enum RentalStatus {
  ACTIVE
  ON_LEAVING
  ENDED
}

enum MonthlyDueStatus {
  UNPAID
  PARTIAL
  PAID
}

enum CreditTransactionType {
  CREDIT_CREATED
  CREDIT_APPLIED
  REFUND
}

enum RequestCategory {
  REPAIR
  PERMISSION
  COMPLAINT
}

enum RequestStatus {
  NOT_RESOLVED
  IN_PROGRESS
  RESOLVED
}

model User {
  id             String        @id @default(uuid())
  username       String        @unique
  email          String        @unique
  passwordHashed String
  role           Role
  status         AccountStatus @default(PENDING_ACTIVATION)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  profile            UserProfile?
  tenant             Tenant?
  recordedPayments   Payment[]           @relation("PaymentRecorder")
  creditTransactions CreditTransaction[] @relation("CreditTransactionRecorder")
  announcements      Announcement[]      @relation("AnnouncementAuthor")
  announcementReads  AnnouncementRead[]
  requestUpdates     RequestUpdate[]     @relation("RequestUpdateAuthor")

  activation AccountActivation?

  @@index([role])
  @@index([status])
}

model UserProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  fullName        String
  phone           String?
  profileImageUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model Tenant {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  rentals Rental[]
}

model Unit {
  id          String     @id @default(uuid())
  unitNumber  String     @unique
  description String?
  unitPrice   Decimal    @db.Decimal(10, 2)
  status      UnitStatus @default(AVAILABLE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  rentals              Rental[]
  pendingRegistrations PendingTenantRegistration[]

  @@index([status])
}

model Rental {
  id                 String       @id @default(uuid())
  tenantId           String
  unitId             String
  monthlyRent        Decimal      @db.Decimal(10, 2)
  moveInDate         DateTime     @db.Date
  leavingRequestedAt DateTime?
  endDate            DateTime?    @db.Date
  status             RentalStatus @default(ACTIVE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  unit        Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)
  monthlyDues MonthlyDue[]
  payments    Payment[]
  credit      TenantCredit?
  requests    TenantRequest[]

  @@index([tenantId])
  @@index([unitId])
  @@index([status])
}

model MonthlyDue {
  id            String           @id @default(uuid())
  rentalId      String
  billingPeriod DateTime         @db.Date
  dueDate       DateTime         @db.Date
  amountDue     Decimal          @db.Decimal(10, 2)
  amountPaid    Decimal          @default(0) @db.Decimal(10, 2)
  balance       Decimal          @db.Decimal(10, 2)
  status        MonthlyDueStatus @default(UNPAID)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  rental             Rental              @relation(fields: [rentalId], references: [id], onDelete: Restrict)
  allocations        PaymentAllocation[]
  creditTransactions CreditTransaction[]

  @@unique([rentalId, billingPeriod])
  @@index([rentalId])
  @@index([dueDate])
  @@index([status])
}

model Payment {
  id           String   @id @default(uuid())
  rentalId     String
  amount       Decimal  @db.Decimal(10, 2)
  paymentDate  DateTime @db.Date
  reference    String?  @unique
  note         String?  @db.VarChar(50)
  recordedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rental             Rental              @relation(fields: [rentalId], references: [id], onDelete: Restrict)
  recordedBy         User                @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)
  allocations        PaymentAllocation[]
  creditTransactions CreditTransaction[]

  @@index([rentalId])
  @@index([paymentDate])
  @@index([recordedById])
}

model PaymentAllocation {
  id           String   @id @default(uuid())
  paymentId    String
  monthlyDueId String
  amount       Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now())

  payment    Payment    @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  monthlyDue MonthlyDue @relation(fields: [monthlyDueId], references: [id], onDelete: Restrict)

  @@unique([paymentId, monthlyDueId])
  @@index([monthlyDueId])
}

model TenantCredit {
  id        String   @id @default(uuid())
  rentalId  String   @unique
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rental       Rental              @relation(fields: [rentalId], references: [id], onDelete: Restrict)
  transactions CreditTransaction[]
}

model CreditTransaction {
  id             String                @id @default(uuid())
  tenantCreditId String
  type           CreditTransactionType
  amount         Decimal               @db.Decimal(10, 2)
  paymentId      String?
  monthlyDueId   String?
  recordedById   String?
  createdAt      DateTime              @default(now())
  notes          String?

  tenantCredit TenantCredit @relation(fields: [tenantCreditId], references: [id], onDelete: Restrict)
  payment      Payment?     @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  monthlyDue   MonthlyDue?  @relation(fields: [monthlyDueId], references: [id], onDelete: Restrict)
  recordedBy   User?        @relation("CreditTransactionRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([tenantCreditId])
  @@index([type])
  @@index([paymentId])
  @@index([monthlyDueId])
  @@index([recordedById])
}

model TenantRequest {
  id          String          @id @default(uuid())
  reference   String?         @unique
  rentalId    String
  category    RequestCategory
  status      RequestStatus   @default(NOT_RESOLVED)
  description String          @db.VarChar(500)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  resolvedAt  DateTime?

  rental      Rental              @relation(fields: [rentalId], references: [id], onDelete: Restrict)
  attachments RequestAttachment[]
  updates     RequestUpdate[]

  @@index([rentalId, createdAt])
  @@index([status, createdAt])
  @@index([category])
}

model RequestAttachment {
  id         String   @id @default(uuid())
  requestId  String
  storageKey String
  fileName   String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  request TenantRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([requestId])
}

model RequestUpdate {
  id        String         @id @default(uuid())
  requestId String
  authorId  String
  status    RequestStatus?
  message   String?
  createdAt DateTime       @default(now())

  request TenantRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  author  User          @relation("RequestUpdateAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([authorId])
}

model Announcement {
  id          String   @id @default(uuid())
  authorId    String
  title       String   @db.VarChar(120)
  content     String
  publishedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author User               @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reads  AnnouncementRead[]

  @@index([authorId])
}

model AnnouncementRead {
  id             String   @id @default(uuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([announcementId, userId])
  @@index([userId, readAt])
}

model AccountActivation {
  id         String   @id @default(uuid())
  userId     String   @unique
  otpHash    String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model PendingTenantRegistration {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  username     String   @unique
  passwordHash String
  phone        String?
  unitId       String
  moveInDate   DateTime @db.Date

  otpHash    String
  expiresAt  DateTime
  attempts   Int      @default(0)
  lastSentAt DateTime
  createdAt  DateTime @default(now())

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId])
  @@index([expiresAt])
}

// TODO: If AccountActivation is not used, remove it because PendingTenantRegistration already has OTP and activation logic. Consider merging them into one model for simplicity.
