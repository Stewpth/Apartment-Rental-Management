# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
# Set to the exact number of trusted reverse-proxy hops in production.
# TRUST_PROXY_HOPS=1

# Neon/PostgreSQL: pooled URL for app traffic, unpooled URL for Prisma migrations.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Use a unique random secret of at least 32 characters.
JWT_SECRET=replace-with-a-long-random-secret-before-starting
JWT_EXPIRES_IN=1d

# Gmail SMTP credentials (use a Gmail app password).
EMAIL_USER=your-sender@gmail.com
EMAIL_APP_PASSWORD=replace-with-gmail-app-password

# Server-side Supabase credentials. Never use the service-role key in VITE_ variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-side-secret-key
SUPABASE_REQUEST_ATTACHMENTS_BUCKET=request-attachments
